+func installColoredStrikethrough(on hwnd: HWND, color: Color) {
+    var name = [WCHAR](repeating: 0, count: 64)
+    GetClassNameW(hwnd, &name, Int32(name.count))
+    if String(decoding: name.prefix { $0 != 0 }, as: UTF16.self).lowercased() == "static", GetWindowTextLengthW(hwnd) > 0 {
+        desktopState(hwnd).strikeColor = color
+        InvalidateRect(hwnd, nil, false)
+    }
+    var child = GetWindow(hwnd, UINT(GW_CHILD))
+    while let next = child { installColoredStrikethrough(on: next, color: color); child = GetWindow(next, UINT(GW_HWNDNEXT)) }
+}
+private final class MinimumTextScaleState {
+    let minimum: Double
+    var base = LOGFONTW()
+    var baseHandle: HFONT?
+    var scaledHandle: HFONT?
+    var updating = false
+    init(minimum: Double) { self.minimum = max(0.01, min(1, minimum)) }
+    deinit { if let scaledHandle { DeleteObject(scaledHandle) } }
+    func capture(_ handle: HFONT?) {
+        guard let handle else { return }
+        baseHandle = handle
+        _ = GetObjectW(handle, Int32(MemoryLayout<LOGFONTW>.size), &base)
+    }
+    func fit(_ hwnd: HWND) {
+        guard !updating, let baseHandle else { return }
+        updating = true; defer { updating = false }
+        var rect = RECT(); GetClientRect(hwnd, &rect)
+        guard rect.right > 0 else { return }
+        let count = GetWindowTextLengthW(hwnd)
+        guard count > 0 else { return }
+        var buffer = [WCHAR](repeating: 0, count: Int(count)+1)
+        _ = GetWindowTextW(hwnd, &buffer, count+1)
+        let dc = GetDC(hwnd); let previous = SelectObject(dc, baseHandle)
+        var extent = SIZE()
+        _ = buffer.withUnsafeBufferPointer { GetTextExtentPoint32W(dc, $0.baseAddress, count, &extent) }
+        _ = SelectObject(dc, previous); ReleaseDC(hwnd, dc)
+        let ratio = min(1, max(minimum, Double(rect.right) / Double(max(1,extent.cx))))
+        var description = base
+        let scaledHeight = max(1, Int32((Double(abs(base.lfHeight))*ratio).rounded()))
+        description.lfHeight = base.lfHeight < 0 ? -scaledHeight : scaledHeight
+        if ratio >= 0.999 {
+            _ = SendMessageW(hwnd, UINT(WM_SETFONT), WPARAM(UInt(bitPattern: baseHandle)), 1)
+            if let scaledHandle { DeleteObject(scaledHandle); self.scaledHandle = nil }
+        } else if let replacement = CreateFontIndirectW(&description) {
+            _ = SendMessageW(hwnd, UINT(WM_SETFONT), WPARAM(UInt(bitPattern: replacement)), 1)
+            if let scaledHandle { DeleteObject(scaledHandle) }
+            scaledHandle = replacement
+        }
+    }
+}
+private let minimumTextScaleProc: SUBCLASSPROC = { hwnd, message, wParam, lParam, identifier, pointer in
+    guard let hwnd, pointer != 0 else { return DefSubclassProc(hwnd, message, wParam, lParam) }
+    let state = Unmanaged<MinimumTextScaleState>.fromOpaque(UnsafeMutableRawPointer(bitPattern: UInt(pointer))!).takeUnretainedValue()
+    if message == UINT(WM_NCDESTROY) {
+        let result = DefSubclassProc(hwnd, message, wParam, lParam)
+        Unmanaged<MinimumTextScaleState>.fromOpaque(UnsafeMutableRawPointer(bitPattern: UInt(pointer))!).release()
+        RemoveWindowSubclass(hwnd, minimumTextScaleProc, identifier)
+        return result
+    }
+    let result = DefSubclassProc(hwnd, message, wParam, lParam)
+    if !state.updating {
+        if message == UINT(WM_SETFONT) { state.capture(HFONT(bitPattern: UInt(wParam))) }
+        if message == UINT(WM_SIZE) || message == UINT(WM_SETTEXT) || message == UINT(WM_SETFONT) { state.fit(hwnd) }
+    }
+    return result
+}
+func installMinimumTextScale(on hwnd: HWND, minimum: Double) {
+    let state = MinimumTextScaleState(minimum: minimum)
+    state.capture(HFONT(bitPattern: Int(SendMessageW(hwnd, UINT(WM_GETFONT), 0, 0))))
+    let pointer = Unmanaged.passRetained(state).toOpaque()
+    SetWindowSubclass(hwnd, minimumTextScaleProc, 0x5354, DWORD_PTR(UInt(bitPattern: pointer)))
+    state.fit(hwnd)
+}
