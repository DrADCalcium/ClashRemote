diff --git a/Sources/Backend/Win32/Rendering/DesktopCompatibility.swift b/Sources/Backend/Win32/Rendering/DesktopCompatibility.swift
new file mode 100644
index 0000000..01b860f
--- /dev/null
+++ b/Sources/Backend/Win32/Rendering/DesktopCompatibility.swift
@@ -0,0 +1,383 @@
+import Foundation
+import WinSDK
+import CWin32
+import CWin32Bridge
+import CDesktopCompatibility
+import SwiftOpenUI
+
+private final class DesktopInteraction {
+    var hovered = false
+    var hover: ((Bool) -> Void)?
+    var shape: ((CGRect) -> Path)?
+    var hidden = false
+    var selected = false
+    var checked = false
+    var accessibility = false
+    var brightnessOverlay: HWND?
+    var strikeColor: Color?
+}
+private let desktopProperty: [WCHAR] = Array("SwiftOpenUI.DesktopCompatibility".utf16) + [0]
+private func desktopState(_ hwnd: HWND) -> DesktopInteraction {
+    if let pointer = desktopProperty.withUnsafeBufferPointer({ GetPropW(hwnd, $0.baseAddress) }) {
+        return Unmanaged<DesktopInteraction>.fromOpaque(UnsafeMutableRawPointer(pointer)).takeUnretainedValue()
+    }
+    let value = DesktopInteraction()
+    let pointer = Unmanaged.passRetained(value).toOpaque()
+    desktopProperty.withUnsafeBufferPointer { _ = SetPropW(hwnd, $0.baseAddress, HANDLE(pointer)) }
+    SetWindowSubclass(hwnd, desktopInteractionProc, 0x534f, DWORD_PTR(UInt(bitPattern: pointer)))
+    return value
+}
+private func updateAccessibleState(_ hwnd: HWND, _ state: DesktopInteraction) {
+    guard state.accessibility else { return }
+    var flags: Int32 = 0
+    if state.hidden { flags |= Int32(STATE_SYSTEM_INVISIBLE) }
+    if state.selected { flags |= Int32(STATE_SYSTEM_SELECTED) }
+    if state.checked { flags |= Int32(STATE_SYSTEM_CHECKED) }
+    if GetWindowLongW(hwnd, GWL_STYLE) & WS_TABSTOP != 0 { flags |= Int32(STATE_SYSTEM_FOCUSABLE) }
+    if GetFocus() == hwnd { flags |= Int32(STATE_SYSTEM_FOCUSED) }
+    if !IsWindowEnabled(hwnd) { flags |= Int32(STATE_SYSTEM_UNAVAILABLE) }
+    _ = soui_accessibility_number(UnsafeMutableRawPointer(hwnd), 4, flags)
+}
+private func setAccessibleText(_ hwnd: HWND, field: Int32, value: String) {
+    desktopState(hwnd).accessibility = true
+    value.withCString(encodedAs: UTF16.self) { _ = soui_accessibility_string(UnsafeMutableRawPointer(hwnd), field, $0) }
+}
+private let desktopInteractionProc: SUBCLASSPROC = { hwnd, message, wParam, lParam, identifier, pointer in
+    guard let hwnd, pointer != 0 else { return DefSubclassProc(hwnd, message, wParam, lParam) }
+    let state = Unmanaged<DesktopInteraction>.fromOpaque(UnsafeMutableRawPointer(bitPattern: UInt(pointer))!).takeUnretainedValue()
+    switch message {
+    case UINT(WM_PAINT):
+        if let color = state.strikeColor {
+            let result = DefSubclassProc(hwnd, message, wParam, lParam)
+            let dc = GetDC(hwnd)
+            defer { ReleaseDC(hwnd, dc) }
+            let font = HFONT(bitPattern: Int(SendMessageW(hwnd, UINT(WM_GETFONT), 0, 0)))
+            let oldFont = font.flatMap { SelectObject(dc, $0) }
+            defer { if let oldFont { _ = SelectObject(dc, oldFont) } }
+            var metrics = TEXTMETRICW(); GetTextMetricsW(dc, &metrics)
+            var rect = RECT(); GetClientRect(hwnd, &rect)
+            let rgb = COLORREF(UInt32(max(0,min(255,color.red*255))) | UInt32(max(0,min(255,color.green*255))) << 8 | UInt32(max(0,min(255,color.blue*255))) << 16)
+            let pen = CreatePen(PS_SOLID, 1, rgb)
+            let oldPen = SelectObject(dc, pen)
+            defer { _ = SelectObject(dc, oldPen); DeleteObject(pen) }
+            let step = max(1, metrics.tmHeight)
+            var y = max(1, metrics.tmAscent * 2 / 3)
+            while y < rect.bottom { MoveToEx(dc, 0, y, nil); LineTo(dc, rect.right, y); y += step }
+            return result
+        }
+    case UINT(WM_MOUSEMOVE):
+        if let hover = state.hover, !state.hovered {
+            state.hovered = true
+            var tracking = TRACKMOUSEEVENT()
+            tracking.cbSize = DWORD(MemoryLayout<TRACKMOUSEEVENT>.size)
+            tracking.dwFlags = DWORD(TME_LEAVE)
+            tracking.hwndTrack = hwnd
+            TrackMouseEvent(&tracking)
+            hover(true)
+        }
+    case UINT(WM_MOUSELEAVE):
+        if state.hovered { state.hovered = false; state.hover?(false) }
+    case UINT(WM_NCHITTEST):
+        if let shape = state.shape {
+            var point = POINT(x: Int32(win32_GET_X_LPARAM(lParam)), y: Int32(win32_GET_Y_LPARAM(lParam)))
+            ScreenToClient(hwnd, &point)
+            var rect = RECT(); GetClientRect(hwnd, &rect)
+            let scale = dpiScaleFactor(for: hwnd)
+            let bounds = CGRect(x: 0, y: 0, width: Double(rect.right) / scale, height: Double(rect.bottom) / scale)
+            if !shape(bounds).contains(CGPoint(x: Double(point.x) / scale, y: Double(point.y) / scale)) { return LRESULT(HTTRANSPARENT) }
+        }
+    case UINT(WM_SIZE):
+        if let overlay = state.brightnessOverlay {
+            var rect = RECT(); GetClientRect(hwnd, &rect)
+            SetWindowPos(overlay, nil, 0, 0, rect.right, rect.bottom, UINT(SWP_NOACTIVATE))
+        }
+    case UINT(WM_ENABLE), UINT(WM_SETFOCUS), UINT(WM_KILLFOCUS): updateAccessibleState(hwnd, state)
+    case UINT(WM_NCDESTROY):
+        if state.accessibility { soui_accessibility_clear(UnsafeMutableRawPointer(hwnd)) }
+        desktopProperty.withUnsafeBufferPointer { _ = RemovePropW(hwnd, $0.baseAddress) }
+        Unmanaged<DesktopInteraction>.fromOpaque(UnsafeMutableRawPointer(bitPattern: UInt(pointer))!).release()
+        RemoveWindowSubclass(hwnd, desktopInteractionProc, identifier)
+    default: break
+    }
+    return DefSubclassProc(hwnd, message, wParam, lParam)
+}
+
+extension HoverView: WinRenderable {
+    public func winCreateWidget(in context: RenderContext) -> HWND? {
+        guard let hwnd = winRenderView(content, in: context) else { return nil }
+        desktopState(hwnd).hover = bindActionToCurrentEnvironment(action)
+        return hwnd
+    }
+}
+extension ContentShapeView: WinRenderable {
+    public func winCreateWidget(in context: RenderContext) -> HWND? {
+        guard let hwnd = winRenderView(content, in: context) else { return nil }
+        desktopState(hwnd).shape = { self.shape.path(in: $0) }
+        return hwnd
+    }
+}
+extension AccessibilityLabelView: WinRenderable {
+    public func winCreateWidget(in context: RenderContext) -> HWND? {
+        guard let hwnd = winRenderView(content, in: context) else { return nil }
+        setAccessibleText(hwnd, field: 0, value: label)
+        return hwnd
+    }
+}
+extension AccessibilityAttributeView: WinRenderable {
+    public func winCreateWidget(in context: RenderContext) -> HWND? {
+        guard let hwnd = winRenderView(content, in: context) else { return nil }
+        let state = desktopState(hwnd); state.accessibility = true
+        switch attribute {
+        case .hidden(let hidden): state.hidden = hidden; updateAccessibleState(hwnd, state)
+        case .value(let value): setAccessibleText(hwnd, field: 1, value: value)
+        case .hint(let value): setAccessibleText(hwnd, field: 2, value: value)
+        case .traits(let traits):
+            state.selected = state.selected || traits.contains(.isSelected)
+            updateAccessibleState(hwnd, state)
+            if traits.contains(.isButton) { _ = soui_accessibility_number(UnsafeMutableRawPointer(hwnd), 5, Int32(0x2b) /* MSAA ROLE_SYSTEM_PUSHBUTTON */) }
+        case .children(let behavior):
+            _ = soui_accessibility_number(UnsafeMutableRawPointer(hwnd), 5, Int32(0x14) /* MSAA ROLE_SYSTEM_GROUPING */)
+            if behavior == .combine {
+                var labels: [String] = []
+                func collect(_ window: HWND) {
+                    var buffer = [WCHAR](repeating: 0, count: 1024)
+                    let count = GetWindowTextW(window, &buffer, Int32(buffer.count))
+                    if count > 0 { labels.append(String(decoding: buffer.prefix(Int(count)), as: UTF16.self)) }
+                    var child = GetWindow(window, UINT(GW_CHILD))
+                    while let next = child { collect(next); child = GetWindow(next, UINT(GW_HWNDNEXT)) }
+                }
+                collect(hwnd)
+                if !labels.isEmpty { setAccessibleText(hwnd, field: 0, value: labels.joined(separator: ", ")) }
+            }
+            if behavior != .contain {
+                func hideDescendants(_ parent: HWND) {
+                    var child = GetWindow(parent, UINT(GW_CHILD))
+                    while let next = child {
+                        let attributes = desktopState(next); attributes.accessibility = true; attributes.hidden = true
+                        updateAccessibleState(next, attributes); hideDescendants(next)
+                        child = GetWindow(next, UINT(GW_HWNDNEXT))
+                    }
+                }
+                hideDescendants(hwnd)
+            }
+        }
+        return hwnd
+    }
+}
+
+// Native child-window alpha modulation. This supplies visible press feedback;
+// positive brightness blends toward white, negative brightness toward black.
+extension BrightnessView: WinRenderable {
+    public func winCreateWidget(in context: RenderContext) -> HWND? {
+        guard let hwnd = winRenderView(content, in: context) else { return nil }
+        guard amount != 0 else { return hwnd }
+        var rect = RECT(); GetClientRect(hwnd, &rect)
+        let kind = amount < 0 ? SS_BLACKRECT : SS_WHITERECT
+        let overlay = CreateWindowExW(DWORD(WS_EX_LAYERED | WS_EX_TRANSPARENT), win32_WC_STATIC(), nil,
+            DWORD(WS_CHILD | WS_VISIBLE | kind), 0, 0, rect.right, rect.bottom, hwnd, nil, context.hInstance, nil)
+        if let overlay {
+            SetLayeredWindowAttributes(overlay, 0, BYTE(min(255, abs(amount) * 255)), DWORD(LWA_ALPHA))
+            desktopState(hwnd).brightnessOverlay = overlay
+        }
+        return hwnd
+    }
+}
+
+private final class AdaptiveGridState {
+    let children: [HWND]
+    let heights: [Int32]
+    let horizontalGap: Int32
+    let verticalGap: Int32
+    let columns: (Double) -> Int
+    let maximumCellWidth: Double
+    let alignment: HorizontalAlignment
+    var lastWidth: Int32 = -1
+    var layingOut = false
+    init(children: [HWND], horizontalGap: Int32, verticalGap: Int32, maximumCellWidth: Double, alignment: HorizontalAlignment, columns: @escaping (Double) -> Int) {
+        self.children = children; self.horizontalGap = horizontalGap; self.verticalGap = verticalGap
+        self.columns = columns; self.maximumCellWidth = maximumCellWidth; self.alignment = alignment
+        heights = children.map { var r = RECT(); GetWindowRect($0, &r); return max(1, r.bottom-r.top) }
+    }
+    func layout(_ hwnd: HWND, width: Int32) {
+        guard width > 0, !layingOut, width != lastWidth else { return }
+        layingOut = true; lastWidth = width
+        defer { layingOut = false }
+        let count = max(1, min(max(1, children.count), columns(pxToPoints(Double(width), for: hwnd))))
+        var cellWidth = max(1, (width - Int32(count-1)*horizontalGap) / Int32(count))
+        if maximumCellWidth.isFinite { cellWidth = min(cellWidth, max(1, px(maximumCellWidth, for: hwnd))) }
+        let usedWidth = Int32(count)*cellWidth + Int32(count-1)*horizontalGap
+        let offset: Int32
+        switch alignment { case .leading: offset = 0; case .center: offset = (width-usedWidth)/2; case .trailing: offset = width-usedWidth }
+        var y: Int32 = 0
+        for start in stride(from: 0, to: children.count, by: count) {
+            let end = min(start+count, children.count)
+            let height = heights[start..<end].max() ?? 0
+            for i in start..<end {
+                SetWindowPos(children[i], nil, offset + Int32(i-start)*(cellWidth+horizontalGap), y, cellWidth, height, UINT(SWP_NOZORDER | SWP_NOACTIVATE))
+            }
+            y += height + verticalGap
+        }
+        let height = max(1, y - (children.isEmpty ? 0 : verticalGap))
+        var old = RECT(); GetClientRect(hwnd, &old)
+        if old.bottom != height {
+            SetWindowPos(hwnd, nil, 0, 0, width, height, UINT(SWP_NOMOVE | SWP_NOZORDER | SWP_NOACTIVATE))
+            if let parent = GetParent(hwnd) {
+                var r = RECT(); GetClientRect(parent, &r)
+                let packed = LPARAM((Int(r.bottom) << 16) | (Int(r.right) & 0xffff))
+                PostMessageW(parent, UINT(WM_SIZE), 0, packed)
+            }
+        }
+    }
+}
+private let adaptiveGridProc: SUBCLASSPROC = { hwnd, message, wParam, lParam, id, pointer in
+    guard let hwnd, pointer != 0 else { return DefSubclassProc(hwnd, message, wParam, lParam) }
+    let state = Unmanaged<AdaptiveGridState>.fromOpaque(UnsafeMutableRawPointer(bitPattern: UInt(pointer))!).takeUnretainedValue()
+    if message == UINT(WM_SIZE) { var r = RECT(); GetClientRect(hwnd, &r); state.layout(hwnd, width: r.right) }
+    if message == UINT(WM_COMMAND), let child = HWND(bitPattern: Int(lParam)) { _ = SendMessageW(child, message, wParam, lParam) }
+    if message == UINT(WM_NCDESTROY) {
+        Unmanaged<AdaptiveGridState>.fromOpaque(UnsafeMutableRawPointer(bitPattern: UInt(pointer))!).release()
+        RemoveWindowSubclass(hwnd, adaptiveGridProc, id)
+    }
+    return DefSubclassProc(hwnd, message, wParam, lParam)
+}
+func winCreateAdaptiveGrid<D, V: View>(_ grid: LazyVGrid<D, V>, in context: RenderContext) -> HWND? {
+    guard let hwnd = win32_CreateChildWindow(win32_WC_STATIC(), nil, DWORD(SS_NOTIFY), 0, 0, 1, 1, context.parent, nil, context.hInstance) else { return nil }
+    let childContext = RenderContext(parent: hwnd, hInstance: context.hInstance)
+    let children = grid.items.compactMap { winRenderView(grid.contentBuilder($0), in: childContext) }
+    let gap = grid.gridItems.first?.spacing ?? Double(grid.builderSpacing ?? 8)
+    let maximum: Double
+    if let item = grid.gridItems.first, case .adaptive(_, let max) = item.size { maximum = max } else { maximum = .infinity }
+    let state = AdaptiveGridState(children: children, horizontalGap: px(gap, for: hwnd), verticalGap: px(Double(grid.builderSpacing ?? 8), for: hwnd), maximumCellWidth: maximum, alignment: grid.builderAlignment, columns: { grid.columnCount(availableWidth: $0) })
+    let pointer = Unmanaged.passRetained(state).toOpaque()
+    SetWindowSubclass(hwnd, adaptiveGridProc, 0x5347, DWORD_PTR(UInt(bitPattern: pointer)))
+    markExpandWidth(hwnd)
+    var r = RECT(); GetClientRect(context.parent, &r)
+    state.layout(hwnd, width: r.right > 0 ? r.right : px(600, for: hwnd))
+    return hwnd
+}
+private struct NativeRadioOption: View, WinRenderable {
+    let title: String
+    let selected: Bool
+    let action: () -> Void
+    var body: Never { fatalError() }
+    func winCreateWidget(in context: RenderContext) -> HWND? {
+        let measured = measureText(title, hwnd: context.parent)
+        let hwnd = title.withCString(encodedAs: UTF16.self) { text in
+            win32_CreateChildWindow(win32_WC_BUTTON(), text, DWORD(BS_AUTORADIOBUTTON | WS_TABSTOP), 0, 0, measured.width+px(30, for: context.parent), px(28, for: context.parent), context.parent, nil, context.hInstance)
+        }
+        if let hwnd {
+            _ = SendMessageW(hwnd, UINT(BM_SETCHECK), WPARAM(selected ? BST_CHECKED : BST_UNCHECKED), 0)
+            let handler = SubclassHandler(hwnd: hwnd)
+            handler.onCommand = bindActionToCurrentEnvironment(action)
+        }
+        return hwnd
+    }
+}
+extension Picker {
+    func winCreateRadioWidget(in context: RenderContext) -> HWND? {
+        let view = VStack(alignment: .leading, spacing: 4) {
+            if !getCurrentEnvironment().labelsHidden && !label.isEmpty { Text(label) }
+            ForEach(0..<options.count) { i in NativeRadioOption(title: options[i], selected: selected == i, action: { onChanged?(i) }) }
+        }
+        return winRenderView(view, in: context)
+    }
+}
+
+func winCreateSwitch(label: String, isOn: Binding<Bool>, in context: RenderContext) -> HWND? {
+    let environment = getCurrentEnvironment()
+    let tint = environment.tintColor ?? Color(red: 0.0, green: 0.48, blue: 1.0)
+    let small = environment.controlSize == .small || environment.controlSize == .mini
+    let width: Double = small ? 28 : 36
+    let height: Double = small ? 16 : 22
+    let inset: Double = 2
+    let view = HStack(spacing: 8) {
+        if !label.isEmpty && !environment.labelsHidden { Text(label) }
+        Button(action: { isOn.wrappedValue.toggle() }) {
+            ZStack(alignment: .leading) {
+                Capsule().fill(isOn.wrappedValue ? tint : Color(red: 0.65, green: 0.67, blue: 0.69)).frame(width: width, height: height)
+                Circle().fill(.white).frame(width: height-2*inset, height: height-2*inset)
+                    .offset(x: isOn.wrappedValue ? width-height+inset : inset)
+            }.frame(width: width, height: height)
+        }.buttonStyle(.plain).environment(\.customButtonStyle, nil)
