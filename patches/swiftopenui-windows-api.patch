+// Nonzero winding hit testing. Curves are subdivided into short segments;
+// rendering keeps the original exact cubic/arc representation.
+extension Path {
+    public func contains(_ point: CGPoint) -> Bool {
+        var contours: [[CGPoint]] = []
+        var contour: [CGPoint] = []
+        var cursor = CGPoint.zero
+        func finish() { if !contour.isEmpty { contours.append(contour); contour = [] } }
+        for element in elements {
+            switch element {
+            case .moveTo(let p): finish(); contour = [p]; cursor = p
+            case .lineTo(let p): if contour.isEmpty { contour = [cursor] }; contour.append(p); cursor = p
+            case .curve(let end, let c1, let c2):
+                if contour.isEmpty { contour = [cursor] }
+                let start = cursor
+                for step in 1...32 {
+                    let t = Double(step) / 32, u = 1 - t
+                    contour.append(CGPoint(x: u*u*u*start.x + 3*u*u*t*c1.x + 3*u*t*t*c2.x + t*t*t*end.x,
+                                           y: u*u*u*start.y + 3*u*u*t*c1.y + 3*u*t*t*c2.y + t*t*t*end.y))
+                }
+                cursor = end
+            case .closeSubpath: cursor = contour.first ?? cursor; finish()
+            case .ellipse(let center, let rx, let ry):
+                finish()
+                contour = (0..<64).map { i in let angle = Double(i) * .pi / 32; return CGPoint(x: center.x + rx * cos(angle), y: center.y + ry * sin(angle)) }
+                finish()
+            case .arc(let center, let radius, let start, let end, let clockwise):
+                var delta = end - start
+                if clockwise { while delta > 0 { delta -= 2 * .pi } }
+                else { while delta < 0 { delta += 2 * .pi } }
+                let steps = max(1, Int(ceil(abs(delta) / (.pi / 32))))
+                for step in 0...steps { let a = start + delta * Double(step) / Double(steps); contour.append(CGPoint(x: center.x + radius * cos(a), y: center.y + radius * sin(a))) }
+                cursor = contour.last ?? cursor
+            }
+        }
+        finish()
+        var winding = 0
+        for points in contours where points.count >= 3 {
+            for i in points.indices {
+                let a = points[i], b = points[(i + 1) % points.count]
+                let cross = (b.x-a.x)*(point.y-a.y) - (point.x-a.x)*(b.y-a.y)
+                if a.y <= point.y && b.y > point.y && cross > 0 { winding += 1 }
+                if a.y > point.y && b.y <= point.y && cross < 0 { winding -= 1 }
+            }
+        }
+        return winding != 0
+    }
+}
