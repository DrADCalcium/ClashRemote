diff --git a/Sources/Backend/Win32/CDesktopCompatibility/Accessibility.cpp b/Sources/Backend/Win32/CDesktopCompatibility/Accessibility.cpp
new file mode 100644
index 0000000..caabd7a
--- /dev/null
+++ b/Sources/Backend/Win32/CDesktopCompatibility/Accessibility.cpp
@@ -0,0 +1,89 @@
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#include <initguid.h>
+#include <oleacc.h>
+#include <oleauto.h>
+#include <inputscope.h>
+#include "DesktopCompatibility.h"
+
+// IAccPropServices annotates the standard HWND accessibility provider without
+// replacing the visual text or the native control's keyboard implementation.
+static const GUID *property(int field) {
+    switch (field) {
+    case 0: return &PROPID_ACC_NAME;
+    case 1: return &PROPID_ACC_VALUE;
+    case 2: return &PROPID_ACC_HELP;
+    case 3: return &PROPID_ACC_DESCRIPTION;
+    case 4: return &PROPID_ACC_STATE;
+    case 5: return &PROPID_ACC_ROLE;
+    default: return nullptr;
+    }
+}
+struct Services {
+    IAccPropServices *value = nullptr;
+    bool initialized = false;
+    Services() {
+        HRESULT result = CoInitializeEx(nullptr, COINIT_APARTMENTTHREADED);
+        initialized = SUCCEEDED(result);
+        CoCreateInstance(CLSID_AccPropServices, nullptr, CLSCTX_INPROC_SERVER,
+                         IID_IAccPropServices, reinterpret_cast<void **>(&value));
+    }
+    ~Services() { if (value) value->Release(); if (initialized) CoUninitialize(); }
+};
+static Services &propertyServices() { static thread_local Services services; return services; }
+int32_t soui_accessibility_string(void *window, int field, const uint16_t *value) {
+    Services &services = propertyServices();
+    const GUID *id = property(field);
+    if (!window || !id || !value) return E_INVALIDARG;
+    if (!services.value) return E_NOINTERFACE;
+    return services.value->SetHwndPropStr(static_cast<HWND>(window), OBJID_CLIENT,
+                                        CHILDID_SELF, *id, reinterpret_cast<const wchar_t *>(value));
+}
+int32_t soui_accessibility_number(void *window, int field, int32_t value) {
+    Services &services = propertyServices();
+    const GUID *id = property(field);
+    if (!window || !id) return E_INVALIDARG;
+    if (!services.value) return E_NOINTERFACE;
+    VARIANT variant; VariantInit(&variant); variant.vt = VT_I4; variant.lVal = value;
+    return services.value->SetHwndProp(static_cast<HWND>(window), OBJID_CLIENT, CHILDID_SELF, *id, variant);
+}
+void soui_accessibility_clear(void *window) {
+    Services &services = propertyServices();
+    if (!window || !services.value) return;
+    const GUID properties[] = {PROPID_ACC_NAME, PROPID_ACC_VALUE, PROPID_ACC_HELP,
+                               PROPID_ACC_DESCRIPTION, PROPID_ACC_STATE, PROPID_ACC_ROLE};
+    services.value->ClearHwndProps(static_cast<HWND>(window), OBJID_CLIENT, CHILDID_SELF,
+                                  properties, sizeof(properties) / sizeof(properties[0]));
+}
+int32_t soui_accessibility_read_string(void *window, int field, uint16_t *buffer, size_t capacity) {
+    Services &services = propertyServices();
+    (void)services;
+    IAccessible *accessible = nullptr;
+    HRESULT hr = AccessibleObjectFromWindow(static_cast<HWND>(window), OBJID_CLIENT, IID_IAccessible,
+                                            reinterpret_cast<void **>(&accessible));
+    if (FAILED(hr)) return hr;
+    VARIANT child; VariantInit(&child); child.vt = VT_I4; child.lVal = CHILDID_SELF;
+    BSTR value = nullptr;
+    switch (field) {
+    case 0: hr = accessible->get_accName(child, &value); break;
+    case 1: hr = accessible->get_accValue(child, &value); break;
+    case 2: hr = accessible->get_accHelp(child, &value); break;
+    default: hr = E_INVALIDARG; break;
+    }
+    if (SUCCEEDED(hr) && value && buffer && capacity) {
+        wcsncpy_s(reinterpret_cast<wchar_t *>(buffer), capacity, value, _TRUNCATE);
+    }
+    SysFreeString(value); accessible->Release();
+    return hr;
+}
+
+int32_t soui_text_input_scope(void *window, int kind) {
+    const InputScope scopes[] = {IS_URL, IS_LOGINNAME, IS_PASSWORD, IS_PASSWORD,
+                                IS_EMAIL_SMTPEMAILADDRESS, IS_PERSONALNAME_FULLNAME};
+    if (!window || kind < 0 || kind >= sizeof(scopes)/sizeof(scopes[0])) return E_INVALIDARG;
+    Services &services = propertyServices(); (void)services;
+    using Setter = HRESULT (WINAPI *)(HWND, InputScope);
+    static HMODULE module = LoadLibraryExW(L"msctf.dll", nullptr, LOAD_LIBRARY_SEARCH_SYSTEM32);
+    static Setter setter = module ? reinterpret_cast<Setter>(GetProcAddress(module, "SetInputScope")) : nullptr;
+    return setter ? setter(static_cast<HWND>(window), scopes[kind]) : HRESULT_FROM_WIN32(ERROR_PROC_NOT_FOUND);
+}
