<Window x:Class="ClashRemote.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Clash Remote · Windows" Width="1240" Height="820" MinWidth="1000" MinHeight="680" WindowStartupLocation="CenterScreen">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#E7F0F3" Padding="22,26">
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Top">
     <Image Source="Assets/Logo.png" Width="48" Height="48" HorizontalAlignment="Left" Margin="0,0,0,14"/>
     <TextBlock Text="Clash Remote" FontSize="23" FontWeight="Bold"/>
     <TextBlock Text="WINDOWS  /  OPENCLASH" FontSize="10" Foreground="#56737F" Margin="0,5,0,28"/>
     <TextBlock Text="我的路由器" FontWeight="SemiBold" Margin="0,0,0,8"/>
     <ListBox x:Name="DeviceList" Height="152" Background="Transparent" BorderThickness="0" SelectionChanged="DeviceSelectionChanged"/>
     <WrapPanel Margin="0,14,0,12"><Button Content="＋ 添加" Click="AddDevice"/><Button Content="编辑" Click="EditDevice"/><Button Content="移除" Click="RemoveDevice"/></WrapPanel>
     <Button x:Name="ConnectButton" Content="连接设备" Style="{StaticResource Primary}" Click="ConnectClick"/>
     <Button Content="断开连接" Click="DisconnectClick"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom">
     <TextBlock Text="控制路由器上的 OpenClash" Foreground="#56737F" Margin="0,0,0,6"/>
     <TextBlock Text="v0.1.0 · 基于 DonVitsch/ClashRemote" FontSize="10" Foreground="#56737F" TextWrapping="Wrap"/>
    </StackPanel>
    <StackPanel VerticalAlignment="Bottom" Margin="0,18,0,24">
     <CheckBox x:Name="TrayOnClose" Content="关闭窗口时收起到托盘" IsChecked="True" Margin="0,0,0,12"/>
     <CheckBox Content="窗口置顶" Checked="TopmostOn" Unchecked="TopmostOff"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="28,24,20,16">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,16">
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="刷新" Click="RefreshClick"/><Button Content="打开路由后台" Click="OpenRouter"/></StackPanel>
    <StackPanel><TextBlock x:Name="DeviceTitle" Text="连接你的路由器" FontSize="26" FontWeight="Bold"/><TextBlock x:Name="DeviceSubtitle" Text="添加设备后，即可管理 OpenClash 服务与代理策略。" Foreground="#62808D" Margin="0,6,0,0"/></StackPanel>
   </DockPanel>
   <Border Grid.Row="1" Background="#DFEEF2" CornerRadius="7" Padding="13,10" Margin="0,0,0,16"><TextBlock x:Name="StatusText" Text="尚未连接 · 所有数据均来自实际设备" TextWrapping="Wrap"/></Border>
   <TabControl x:Name="Tabs" Grid.Row="2" Background="Transparent" BorderThickness="0" SelectionChanged="TabChanged">
    <TabItem Header="总览">
     <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,20,0,0">
      <UniformGrid Columns="3">
       <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="OPENCLASH 服务" Foreground="#62808D"/><TextBlock x:Name="ServiceValue" Text="—" FontSize="26" FontWeight="Bold" Margin="0,10,0,0"/><TextBlock x:Name="ServiceHint" Text="等待连接" Foreground="#62808D" Margin="0,6,0,0"/></StackPanel></Border>
       <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="累计下载 / 上传" Foreground="#62808D"/><TextBlock x:Name="TrafficValue" Text="—" FontSize="22" FontWeight="Bold" Margin="0,12,0,0"/><TextBlock x:Name="RateValue" Text="等待流量数据" Foreground="#62808D" Margin="0,8,0,0"/></StackPanel></Border>
       <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="活动连接" Foreground="#62808D"/><TextBlock x:Name="ConnectionsValue" Text="—" FontSize="28" FontWeight="Bold" Margin="0,8,0,0"/><TextBlock Text="每 3 秒刷新当前页面" Foreground="#62808D" Margin="0,5,0,0"/></StackPanel></Border>
      </UniformGrid>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="代理模式" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/><TextBlock x:Name="ModeValue" Text="—" Margin="0,0,0,14"/><WrapPanel x:Name="ModeButtons"><Button Content="规则" Tag="rule" Click="ModeClick"/><Button Content="直连" Tag="direct" Click="ModeClick"/><Button Content="全局" Tag="global" Click="ModeClick"/></WrapPanel><TextBlock Text="直连模式仍保持服务运行；停止服务请使用「设备控制」。" Foreground="#62808D" Margin="0,8,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="当前配置" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="ConfigValue" Text="—" TextWrapping="Wrap" Margin="0,12,0,0"/><TextBlock x:Name="CoreValue" Text="—" Foreground="#62808D" Margin="0,8,0,0"/></StackPanel></Border>
     </StackPanel></ScrollViewer>
    </TabItem>
    <TabItem Header="设备控制">
     <StackPanel Margin="0,20,0,0">
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="OpenClash 服务" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="通过路由器管理接口启停，并重新读取运行状态确认结果。" Foreground="#62808D" Margin="0,8,0,20"/><WrapPanel><Button Content="启动 OpenClash" Tag="start" Click="ServiceClick" Style="{StaticResource Primary}"/><Button Content="停止 OpenClash" Tag="stop" Click="ServiceClick"/><Button Content="重启 OpenClash" Tag="restart" Click="ServiceClick"/></WrapPanel></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="流量接管方式" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="CaptureValue" Text="—" Margin="0,10,0,16"/><WrapPanel><Button Content="增强" Tag="" Click="CaptureClick"/><Button Content="TUN" Tag="-tun" Click="CaptureClick"/><Button Content="Mix" Tag="-mix" Click="CaptureClick"/></WrapPanel></StackPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="面板入口" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/><WrapPanel><Button Content="打开路由器内置面板" Click="OpenPanel"/><Button Content="刷新 OpenClash 日志" Click="LogClick"/></WrapPanel><TextBlock Text="内置面板是否为 Zashboard，取决于路由器的面板设置。" TextWrapping="Wrap" Foreground="#62808D"/></StackPanel></Border>
     </StackPanel>
    </TabItem>
    <TabItem Header="节点">
     <Grid Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel><Button Content="刷新节点" DockPanel.Dock="Right" Click="NodesRefresh"/><ComboBox x:Name="GroupPicker" SelectionChanged="GroupChanged" MinWidth="300"/></DockPanel>
      <WrapPanel Grid.Row="1"><Button Content="使用所选节点" Click="SelectNode"/><Button Content="测速所选节点" Click="TestNode"/><Button Content="测速当前组" Click="TestGroup"/><TextBlock x:Name="GroupHint" VerticalAlignment="Center" Foreground="#62808D"/></WrapPanel>
      <DataGrid x:Name="NodesGrid" Grid.Row="2"><DataGrid.Columns><DataGridTextColumn Header="节点" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="协议" Binding="{Binding Type}" Width="130"/><DataGridTextColumn Header="延迟 (ms)" Binding="{Binding Delay}" Width="130"/><DataGridTextColumn Header="可达" Binding="{Binding Alive}" Width="90"/></DataGrid.Columns></DataGrid>
     </Grid>
    </TabItem>
    <TabItem Header="连接">
     <Grid Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><WrapPanel><Button Content="刷新连接" Click="ConnectionsRefresh"/><Button Content="关闭所选连接" Click="CloseConnection"/><Button Content="关闭全部连接" Click="CloseAllConnections"/></WrapPanel>
      <DataGrid Grid.Row="1" x:Name="ConnectionsGrid"><DataGrid.Columns><DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="130"/><DataGridTextColumn Header="目标" Binding="{Binding Destination}" Width="220"/><DataGridTextColumn Header="协议" Binding="{Binding Network}" Width="65"/><DataGridTextColumn Header="策略链" Binding="{Binding Chain}" Width="200"/><DataGridTextColumn Header="命中规则" Binding="{Binding Rule}" Width="230"/><DataGridTextColumn Header="下载字节" Binding="{Binding Download}" Width="110"/></DataGrid.Columns></DataGrid>
     </Grid>
    </TabItem>
    <TabItem Header="规则与集合">
     <Grid Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="150"/></Grid.RowDefinitions>
      <DockPanel><Button Content="刷新规则" Click="RulesRefresh" DockPanel.Dock="Right"/><TextBox x:Name="RuleSearch" TextChanged="SearchRules" ToolTip="搜索规则类型、内容或策略"/></DockPanel>
      <DataGrid Grid.Row="1" x:Name="RulesGrid"><DataGrid.Columns><DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="150"/><DataGridTextColumn Header="匹配内容" Binding="{Binding Payload}" Width="*"/><DataGridTextColumn Header="策略" Binding="{Binding Proxy}" Width="180"/></DataGrid.Columns></DataGrid>
      <WrapPanel Grid.Row="2" Margin="0,14,0,0"><CheckBox x:Name="RuleProviders" Content="规则集合（取消为代理集合）" Margin="0,8,18,0"/><Button Content="读取集合" Click="ProvidersRefresh"/><Button Content="更新所选集合" Click="UpdateProvider"/></WrapPanel>
      <DataGrid x:Name="ProvidersGrid" Grid.Row="3"><DataGrid.Columns><DataGridTextColumn Header="集合" Binding="{Binding Name}" Width="*"/><DataGridTextColumn Header="类型" Binding="{Binding Type}" Width="120"/><DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedAt}" Width="260"/></DataGrid.Columns></DataGrid>
     </Grid>
    </TabItem>
    <TabItem Header="订阅与配置">
     <Grid Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="190"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <WrapPanel><Button Content="刷新订阅与配置" Click="ProfilesRefresh"/><Button Content="添加订阅" Click="AddSubscription"/><Button Content="编辑所选订阅" Click="EditSubscription"/><Button Content="删除所选订阅" Click="DeleteSubscription"/></WrapPanel>
      <TextBlock Grid.Row="1" Text="保存订阅不会自动下载或重启；需要时点击更新。" Foreground="#62808D" Margin="0,0,0,8"/>
      <DataGrid x:Name="SubscriptionsGrid" Grid.Row="2"><DataGrid.Columns><DataGridTextColumn Header="订阅" Binding="{Binding Name}" Width="*"/><DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled}" Width="70"/><DataGridTextColumn Header="User-Agent" Binding="{Binding UserAgent}" Width="200"/></DataGrid.Columns></DataGrid>
      <WrapPanel Grid.Row="3" Margin="0,14,0,0"><ComboBox x:Name="FilePicker" Width="220"/><Button Content="切换配置" Click="SwitchConfig"/><Button Content="更新所选订阅" Click="UpdateSubscription"/><Button Content="读取配置" Click="ReadConfig"/><Button Content="备份并保存" Click="SaveConfig"/></WrapPanel>
      <TextBox x:Name="ConfigEditor" Grid.Row="4" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Cascadia Mono,Consolas" FontSize="12" IsReadOnly="True" Text="选择配置后点击读取；保存不会自动应用。"/>
     </Grid>
    </TabItem>
    <TabItem Header="日志"><Grid Margin="0,16,0,0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Button Content="读取路由器日志（最后 600 行）" Click="LogClick" HorizontalAlignment="Left"/><TextBox Grid.Row="1" x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" FontFamily="Cascadia Mono,Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/></Grid></TabItem>
   </TabControl>
   <DockPanel Grid.Row="3" Margin="0,16,0,0"><TextBlock x:Name="LastUpdated" Text="未连接" Foreground="#62808D"/><TextBlock Text="Windows 原生客户端 · 无需本机代理内核" HorizontalAlignment="Right" Foreground="#62808D" FontSize="11"/></DockPanel>
  </Grid>
 </Grid>
</Window>
